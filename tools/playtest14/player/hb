#!/bin/bash
# hunt the nearest roaming monster until a battle starts, then wait for my turn
S=/tmp/claude-0/-home-claude--/1ac51525-de24-5872-9bf6-4fc024f0c0db/scratchpad; G=$S/pp/g
for i in $(seq 1 8); do if $G st | grep -q "\"sc\":\"Battle\""; then $S/pp/bw; exit; fi; r=$($G ev "() => __hunt()"); [ -n "$V" ] && echo "hunt: $r"; case "$r" in *battle*) $S/pp/bw; exit;; esac; $S/pp/talk 15 | grep -v '^FREE'; $G step 20 >/dev/null; done; echo "NO BATTLE $($G st)"
